PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/tuturio
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
INVITE_DEFAULT_EXPIRY_DAYS=7

# Seeded tutor (used by npm run seed:tutor)
TUTOR_EMAIL=tutor@tuturio.local
TUTOR_PASSWORD=ChangeMeNow123456!
TUTOR_NAME=Demo Tutor

# SMTP email delivery (required when NODE_ENV=production)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=Tuturio <noreply@example.com>
