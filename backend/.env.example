PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/tuturio?retryWrites=true&w=majority
CLIENT_URL=http://localhost:5173
JWT_ACCESS_SECRET=your-access-secret-min-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
INVITE_DEFAULT_EXPIRY_DAYS=7

# Seeded tutor (used by npm run seed:tutor)
TUTOR_EMAIL=tutor@tuturio.local
TUTOR_PASSWORD=MeeraJoshi8
TUTOR_NAME=Meera Joshi

# Real email (Gmail). Required for "Send email" on invites and password reset.
# 1. Turn on 2-Step Verification for the Gmail account that will send mail.
# 2. Create an App Password: Google Account → Security → App passwords.
# 3. Paste that 16-character password below (not your normal Gmail password).
# 4. Restart the API after saving.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-app-password
EMAIL_FROM=Tuturio <your-gmail@gmail.com>

# Storage Configuration: Use 'local' during development or 'cloudinary' for production.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Optional HTTP virus-scan hook. Leave empty in development (uploads are allowed).
FILE_SCAN_URL=